{
  "name": "dynamic-calc-mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "check:build": "node scripts/check-build.mjs",
    "predev": "npm run prepare:adapter",
    "prebuild": "npm run prepare:adapter",
    "prepare:adapter": "node scripts/prepare-adapter.mjs",
    "test:browser": "npm run prepare:adapter && node scripts/test-browser.mjs"
  },
  "dependencies": {
    "@ionic/react": "9.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
